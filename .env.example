# Copy to .env (repo root). Never commit the real file.

# Meta Model API (https://dev.meta.ai): Muse Spark, Muse Image, SAM 3.1, Voice Transcribe
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# fal.ai: SAM 3D Objects (scan pipeline only)
FAL_KEY=

# Web server: signs session cookies and dev file URLs (32+ random characters)
AUTH_SECRET=
# The scan guests may replay: <owner id>/<scan id> (printed by `npx tsx scripts/seed.ts --demo ...`)
AYNA_DEMO_SCAN=
# The run /app/?autoplay plays (a run id of the demo scan; without it, its best run)
# AYNA_DEMO_RUN=

# Production storage: a private Cloudflare R2 bucket, reached over its S3 API with a token scoped to that
# bucket (Workers R2 Storage Bucket Item Read + Write). The server on Vercel sets AYNA_STORE=r2; local tools
# reach production the same way (AYNA_STORE=r2 npm run worker). Without it: ../data/store on disk.
# AYNA_STORE=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=ayna-store
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Local store folder override (default: data/store)
# AYNA_STORE_DIR=

# Scripts (web/scripts/eval.ts, policies.ts): the server and the account whose runs they save and read
# AYNA_URL=http://localhost:5190
# AYNA_EMAIL=
# AYNA_PASSWORD=
# One JSON line per eval run (default: data/eval-runs.jsonl; landing-numbers.mjs reads it)
# AYNA_EVAL_LOG=
